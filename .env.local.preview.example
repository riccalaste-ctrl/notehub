# Local-only preview configuration template.
# Copy to .env.local.preview and fill with non-production/demo credentials.
NODE_ENV=development
PREVIEW_BYPASS_AUTH=true
NEXT_PUBLIC_SUPABASE_URL=https://preview-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=preview-anon-key
SUPABASE_SERVICE_ROLE_KEY=preview-service-role-key
JWT_SECRET=replace-with-32-plus-random-preview-secret
ADMIN_EMAIL=admin@notehub.local
ADMIN_PASSWORD=preview-only-admin-password
TITOLARE_PASSWORD=different-preview-only-titolare-password
ALLOWED_EMAIL_DOMAIN=liceoscacchibari.it
APP_URL=http://localhost:3001
CRON_SECRET=preview-only-cron-secret

CRON_SECRET=preview-only-cron-secret
RESEND_API_KEY=re_preview_only
RESEND_FROM_EMAIL=NoteHub <noreply@example.com>
