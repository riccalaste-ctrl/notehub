# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-replace-me
SESSION_SECRET=your-super-secret-session-key-min-32-characters
SESSION_MAX_AGE=86400
ADMIN_EMAIL=admin@notehub.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Server-only second factor for Admin > Titolare. Never use NEXT_PUBLIC_ here.
TITOLARE_PASSWORD=replace-with-a-different-strong-titolar-password
TITOLARE_LOGIN_MAX_ATTEMPTS=5
ALLOWED_EMAIL_DOMAIN=liceoscacchibari.it
# Optional: comma-separated external emails allowed for temporary testing
# Developer emails (riccalaste@gmail.com) have permanent access and are hardcoded in src/lib/user-session.ts
ALLOWED_TEST_EMAILS=

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV=production
# Canonical server-only origin used for OAuth redirects. Required when deployed.
APP_URL=https://notehub.example.com
MAX_UPLOAD_SIZE_MB=50

# ============================================
# GOOGLE DRIVE MULTI-ACCOUNT OAUTH
# ============================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Generate a 32+ char random value, or 32 random bytes encoded as base64/64-char hex.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-min-32-chars

# ============================================
# ANALYTICS & MONITORING
# ============================================
# VERCEL_ANALYTICS_ID=your-analytics-id
